{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "page",
            "hero",
            "section",
            "container",
            "grid",
            "card",
            "heading",
            "text",
            "image",
            "button"
          ]
        },
        "fields": {
          "type": "object"
        },
        "children": {
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "fields",
        "children"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "page"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "page"
              },
              "fields": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "hero",
                        "section"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hero"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "hero"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 80
                  },
                  "alignment": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  }
                },
                "required": [
                  "title",
                  "alignment"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "heading",
                        "text",
                        "image",
                        "button"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 0,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "section"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "container",
                        "grid"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "container"
              },
              "fields": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "heading",
                        "text",
                        "image",
                        "button",
                        "grid"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 0,
                "maxItems": 20
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grid"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "grid"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "columns": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "gap": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "columns"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "card"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 12
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "card"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "card"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "image",
                        "heading",
                        "text",
                        "button"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "allOf": [
                    {
                      "$ref": "#/$defs/node"
                    }
                  ]
                },
                "minItems": 0,
                "maxItems": 6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "heading"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "level": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 6
                  }
                },
                "required": [
                  "text",
                  "level"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": false,
                "minItems": 0,
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "text"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "required": [
                  "content"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": false,
                "minItems": 0,
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "image"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": false,
                "minItems": 0,
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "button"
              },
              "fields": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "variant": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "secondary",
                      "outline"
                    ]
                  }
                },
                "required": [
                  "label",
                  "url",
                  "variant"
                ],
                "additionalProperties": false
              },
              "children": {
                "type": "array",
                "items": false,
                "minItems": 0,
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "page"
    },
    "fields": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "hero",
              "section"
            ]
          }
        },
        "required": [
          "type"
        ],
        "allOf": [
          {
            "$ref": "#/$defs/node"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "id",
    "type",
    "fields",
    "children"
  ],
  "additionalProperties": false
}
