{
  "name": "@schema-validation-poc/page-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test src/*.test.ts ajv/tests/*.test.ts tests/*.test.ts",
    "test:page-engine": "npm test",

    "test:wasm": "npm run build:wasm && tsx --test tests/wasm.contract.test.ts",

    "test:page-engine:ajv": "tsx --test ajv/tests/validator.test.ts",
    "test:page-engine:parity": "tsx --test tests/parity.test.ts",

    "page-engine:schema": "tsx ajv/generate-schema.ts",
    "test:page-engine:schema": "tsx --test ajv/tests/generated-schema.test.ts",
    "test:wasm:incremental:parity": "tsx --test tests/wasm.incremental.parity.test.ts",

    "build:wasm": "wasm-pack build rust --target web --out-dir ../wasm"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}